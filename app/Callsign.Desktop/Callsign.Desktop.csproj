<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Callsign.Desktop</RootNamespace>
    <AssemblyName>Callsign</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WebView2 ships an (unused) WPF assembly that references an older WindowsBase; harmless here. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- Hosts the Callsign web app in-process; needs both the desktop and ASP.NET Core shared frameworks. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="0.0.1053" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Callsign.Host\Callsign.Host.csproj" />
  </ItemGroup>

  <!-- Bundle the built web UI next to the exe (skipped if the UI hasn't been built yet). -->
  <ItemGroup Condition="Exists('..\..\ui\dist')">
    <Content Include="..\..\ui\dist\**\*" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
