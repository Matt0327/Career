<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Multi-target: the portable net10.0 build keeps CI + the API integration tests
         cross-platform; the net10.0-windows build references the SimConnect adapter and
         streams live MSFS telemetry. `dotnet run/publish` on Windows needs -f net10.0-windows. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>Callsign.Host</RootNamespace>
  </PropertyGroup>

  <!-- The Windows build runs as x64 so it can load the native SimConnect.dll. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Callsign.Core\Callsign.Core.csproj" />
  </ItemGroup>

  <!-- Hand-picked aircraft photos, bundled with the app so they always load (Wikimedia rate-limits
       runtime fetches). Credited to Wikimedia Commons in the image caption; sources in CuratedAircraftImages. -->
  <ItemGroup>
    <Content Include="CuratedImages\**\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Live telemetry is wired only into the Windows build. On net10.0 the SimConnect adapter
       type doesn't exist, so SimTelemetryFactory falls back to the synthetic source (see #if WINDOWS). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\Callsign.SimConnect.Windows\Callsign.SimConnect.Windows.csproj" />
  </ItemGroup>
</Project>
