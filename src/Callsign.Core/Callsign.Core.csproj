<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Callsign.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Pin the native SQLite bundle above the version flagged by NU1903 (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Callsign.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled OurAirports snapshot (public domain), gzipped and embedded so the app works
         offline out of the box and never asks the user to place a file (brief §3.6). -->
    <EmbeddedResource Include="Assets\ourairports\airports.csv.gz">
      <LogicalName>Callsign.Core.ourairports.airports.csv.gz</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\ourairports\runways.csv.gz">
      <LogicalName>Callsign.Core.ourairports.runways.csv.gz</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
