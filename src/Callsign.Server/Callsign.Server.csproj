<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Callsign Cloud: the online service the desktop app talks to (accounts, cloud saves, and later the
       aircraft-image index + shared world). Cross-platform net10.0 only — it deploys to a Linux host and
       has no Windows/SimConnect dependency. Dev DB is SQLite (free, no infra); the provider swaps to
       Postgres at deploy time without touching the model. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Callsign.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pin the native SQLite bundle above the version flagged by NU1903 (matches Callsign.Core). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>
</Project>
