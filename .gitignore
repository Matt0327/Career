# ---- Rider / VS Code (keep shared settings, ignore local) ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json.sample

# ---- Secrets / local env (NEVER commit — e.g. the Supabase service_role key) ----
.env
.env.*
!.env.example

# ---- App data ----
*.db
*.db-shm
*.db-wal
*.sqlite

# ---- SimConnect redistributables (fetched locally, never committed) ----
vendor/simconnect/*.dll
vendor/simconnect/*.lib
vendor/simconnect/*.exp

# ---- Packaging output (scripts/package.ps1) ----
dist/
installer/out/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
