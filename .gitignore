# ---- .NET ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.user
*.suo
*.userprefs
project.lock.json
artifacts/
.vs/
*.dll.config

# ---- Test / coverage ----
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.trx

# ---- Node / UI ----
node_modules/
ui/dist/
ui/.vite/
npm-debug.log*
yarn-error.log*
